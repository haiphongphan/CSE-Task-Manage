# ⚠️ File này được commit lên Git — CHỈ để giá trị mẫu, KHÔNG điền mật khẩu / khoá thật.
#    Copy thành .env (đã có trong .gitignore) rồi điền giá trị thật vào .env.

# Chuỗi kết nối PostgreSQL. Homebrew: user = tên đăng nhập macOS (lệnh `whoami`), không mật khẩu.
# Supabase: dùng "Session pooler" (xem DEPLOY.md).
DATABASE_URL="postgresql://YOURUSERNAME@localhost:5432/cse_task_manage"

# Khoá ký JWT — tạo bằng: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Cổng chạy API
PORT=4000

# Các origin web được phép gọi API (CORS), cách nhau bởi dấu phẩy
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Địa chỉ web — dùng tạo link trong email
WEB_URL="http://localhost:3000"

# ---------- Bản tin hằng ngày (gộp mọi task còn lại: push + email) ----------
# Biểu thức cron theo giờ Việt Nam. Mặc định 09:00 mỗi ngày
DIGEST_CRON="0 9 * * *"
DIGEST_HOUR=9
# Khởi động API sau 09:00 mà hôm nay chưa gửi -> gửi bù (DB chặn gửi trùng)
DIGEST_CATCH_UP_ON_START=true
# Bí mật cho dịch vụ hẹn giờ bên ngoài gọi POST /api/cron/daily-digest (để trống = tắt endpoint)
CRON_SECRET=

# ---------- Thông báo đẩy cho app Android (.apk) qua Expo ----------
#   log  = chỉ in ra console (mặc định)
#   expo = gửi thật qua Expo Push Service tới điện thoại đã đăng ký token
PUSH_PROVIDER=log
# Chỉ cần khi bật "Enhanced Push Security" trên expo.dev
EXPO_ACCESS_TOKEN=

# ---------- Web Push (thông báo trên iPhone qua web app / trình duyệt) ----------
# Tạo một lần:  npx web-push generate-vapid-keys
# Để trống = chỉ in thông báo ra console. KHÔNG đổi khoá sau khi đã có người đăng ký
# (đổi khoá thì mọi thiết bị phải bật thông báo lại).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Liên hệ của bạn (Apple/Google yêu cầu): mailto:email-cua-ban@gmail.com
VAPID_SUBJECT="mailto:admin@example.com"

# ---------- Email ----------
#   log    = chỉ in ra console (mặc định)
#   resend = gửi thật qua https://resend.com
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Khi chưa xác minh tên miền trên Resend chỉ dùng được onboarding@resend.dev
# (và chỉ gửi được tới email của chính tài khoản Resend)
EMAIL_FROM="CSE Task Manage <onboarding@resend.dev>"
