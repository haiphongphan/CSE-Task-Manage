# Chuỗi kết nối PostgreSQL (Homebrew mặc định: user = tên đăng nhập macOS, không mật khẩu)
# Dạng: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://phongphanhai06@localhost:5432/cse_task_manage"

# Khoá ký JWT — đổi thành chuỗi ngẫu nhiên dài (VD: openssl rand -hex 32)
JWT_SECRET="5ffd1c15bf3c9da270d804ccb7559367b664b3ed06d64777a85a7b72b07e8498"
JWT_EXPIRES_IN="7d"

# Cổng chạy API
PORT=4000

# Các origin web được phép gọi API (CORS), cách nhau bởi dấu phẩy
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Nhắc nhở tự động: biểu thức cron (giờ Việt Nam). Mặc định 08:00 mỗi ngày
REMINDER_CRON="0 8 * * *"
# Chạy nhắc nhở một lần ngay khi API khởi động (tiện demo)
REMINDER_RUN_ON_START=true

# Cách gửi thông báo đẩy (push):
#   log  = chỉ in ra console (mặc định, dùng khi demo)
#   expo = gửi thật qua Expo Push Service tới điện thoại đã đăng ký token
PUSH_PROVIDER=log
# Chỉ cần khi bật "Enhanced Push Security" trên expo.dev, để trống cũng được
EXPO_ACCESS_TOKEN=
